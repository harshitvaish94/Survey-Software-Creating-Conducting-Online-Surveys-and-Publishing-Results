# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=sms
DB_PASSWORD=sms_password
DB_NAME=sms_db
DB_MIGRATIONS_RUN=true

# Authentication Configuration
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Base URL used in shareable links and QR codes (SMS-24)
PUBLIC_BASE_URL=http://localhost:5173

# IANA time zone used to decide when a survey opens/closes (SMS-23)
SURVEY_TIMEZONE=UTC
# SMS-34 rate limiting (per client IP). Set TRUST_PROXY=1 when the API runs behind Nginx.
TRUST_PROXY=
RATE_LIMIT_ENABLED=true
# Optional overrides: RATE_LIMIT_LOGIN=30 RATE_LIMIT_REGISTER=30 RATE_LIMIT_FORGOT_PASSWORD=10
#                     RATE_LIMIT_RESET_PASSWORD=10 RATE_LIMIT_SUBMIT=120

# SMS-34 hCaptcha on login and survey submission. Leave empty to turn it off.
# Test keys that always pass: site 10000000-ffff-ffff-ffff-000000000001, secret 0x0000000000000000000000000000000000000000
HCAPTCHA_SECRET=
VITE_HCAPTCHA_SITE_KEY=
